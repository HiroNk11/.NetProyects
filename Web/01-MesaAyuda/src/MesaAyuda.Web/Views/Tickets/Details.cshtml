@model TicketDetailView
@using MesaAyuda.Web.Services
@{ ViewData["Title"] = $"MESA-{Model.Ticket.Id:D4}"; var ticket = Model.Ticket; }
<a class="back-link" asp-action="Index">← Volver a la bandeja</a>
<div class="page-heading"><div><p class="eyebrow">MESA-@ticket.Id.ToString("D4") / DETALLE DE SOLICITUD</p><h1 class="detail-title">@ticket.Title</h1><p class="muted">Creado por @ticket.Requester.DisplayName · @ticket.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</p></div><span class="badge @ticket.Status">@StatusText.Label(ticket.Status)</span></div>
<div class="detail-grid">
<div class="stack">
    <section class="panel form-panel"><h2>Descripción</h2><p class="preserve">@ticket.Description</p></section>
    <section class="panel form-panel">
        <h2>Conversación <span class="count">@ticket.Comments.Count</span></h2>
        @foreach (var comment in ticket.Comments.OrderBy(c => c.CreatedAt).ThenBy(c => c.Id))
        {
            <article class="comment"><div><strong>@comment.Author.DisplayName</strong><time>@comment.CreatedAt.ToString("dd/MM HH:mm") UTC</time></div><p class="preserve">@comment.Body</p></article>
        }
        @if (ticket.Comments.Count == 0) { <p class="muted">Todavía no hay comentarios. Agregá contexto o compartí un avance.</p> }
        @if (ticket.Status != TicketStatus.Cerrado)
        {
            <form asp-action="Comment" asp-route-id="@ticket.Id" method="post" class="stack">
                <input type="hidden" name="Version" value="@ticket.Version" />
                <div><label for="Body">Nuevo comentario</label><textarea id="Body" name="Body" rows="3" maxlength="2000" required placeholder="Escribí una actualización..."></textarea></div>
                <div><button class="button primary">Agregar comentario</button></div>
            </form>
        }
        else { <p class="notice">Este ticket está cerrado y conserva su historial de seguimiento.</p> }
    </section>
    <section class="panel form-panel"><h2>Historial de actividad</h2><ol class="timeline">
        @foreach (var entry in ticket.Events.OrderByDescending(e => e.CreatedAt).ThenByDescending(e => e.Id))
        { <li><strong>@entry.Description</strong><span>@entry.Actor.DisplayName · @entry.CreatedAt.ToString("dd/MM/yyyy HH:mm") UTC</span></li> }
    </ol></section>
</div>
<aside class="stack">
    <section class="panel form-panel"><p class="eyebrow">SEGUIMIENTO</p><h2>Datos del caso</h2><dl>
        <dt>Prioridad</dt><dd><span class="priority @ticket.Priority"><i class="dot"></i>@ticket.Priority</span></dd>
        <dt>Responsable</dt><dd>@(ticket.Technician?.DisplayName ?? "Sin asignar")</dd>
        <dt>Última actividad</dt><dd>@ticket.UpdatedAt.ToString("dd/MM/yyyy HH:mm") UTC</dd>
    </dl></section>
    @if (Model.CanAssign && ticket.Status != TicketStatus.Cerrado && Model.Technicians.Any(t => t.Id != ticket.TechnicianId))
    {
        <section class="panel form-panel"><h2>Asignar responsable</h2><form asp-action="Assign" asp-route-id="@ticket.Id" method="post" class="stack">
            <input type="hidden" name="Version" value="@ticket.Version" />
            <div><label for="TechnicianId">Técnico</label><select name="TechnicianId" id="TechnicianId" required><option value="">Seleccionar técnico</option>
                @foreach (var tech in Model.Technicians.Where(t => t.Id != ticket.TechnicianId))
                { <option value="@tech.Id">@tech.DisplayName</option> }
            </select></div><button class="button secondary">Guardar asignación</button>
        </form></section>
    }
    @if (Model.CanManage && ticket.Status != TicketStatus.Cerrado)
    {
        <section class="panel form-panel"><h2>Actualizar estado</h2>
        @if (ticket.TechnicianId is null)
        { <p class="muted">Asigná un técnico antes de comenzar la atención.</p> }
        else
        {
            <form asp-action="Status" asp-route-id="@ticket.Id" method="post" class="stack">
                <input type="hidden" name="Version" value="@ticket.Version" />
                <div><label for="Status">Próximo estado</label><select id="Status" name="Status">
                @foreach (var status in Enum.GetValues<TicketStatus>().Where(s => TicketService.CanTransition(ticket.Status, s)))
                { <option value="@status">@StatusText.Label(status)</option> }
                </select></div><button class="button secondary">Actualizar estado</button>
            </form>
        }
        </section>
    }
</aside>
</div>
